// GALACTIC CONQUEST ULTIMATE - Juego espacial épico
board Galaxy loop 15;

// Estaciones espaciales con mecánicas únicas
cell 0 "Command Center" cost 0 rent 50;
cell 1 "Power Station" cost 0 rent 40;
cell 2 "Mega Base" cost 0 rent 60;
cell 3 "Death Trap" cost 30 rent 0;
cell 4 "Trading Hub" cost 10 rent 20;
cell 5 "Resource Mine" cost 0 rent 30;
cell 6 "Combat Zone" cost 5 rent 10;
cell 7 "Black Hole" cost 25 rent 0;
cell 8 "Energy Core" cost 0 rent 35;
cell 9 "Battle Station" cost 8 rent 15;
cell 10 "Plasma Cannon" cost 40 rent 0;
cell 11 "Shield Generator" cost 0 rent 25;
cell 12 "Warp Gate" cost 15 rent 20;
cell 13 "Starforge" cost 0 rent 60;
cell 14 "Victory Point" cost 0 rent 50;

// 3 comandantes galácticos
player 1 money 500 position 0 strategy "aggressive";
player 2 money 500 position 5 strategy "conservative";
player 3 money 500 position 10 strategy "balanced";

// Sistema de dados múltiple
dice 6 sides;
dice 8 sides;
dice 10 sides;

// Simulación épica
simulate 100 turns {}
