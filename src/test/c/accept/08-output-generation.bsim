// Test A1.8: Generar outputs mediante print y log
// Verifica: múltiples statements de print y log para salida de datos

board OutputBoard loop 10;

cell 0 "Start" cost 0 rent 0;
cell 3 "Checkpoint A" cost 50 rent 10;
cell 6 "Checkpoint B" cost 100 rent 20;
cell 9 "Finish" cost 150 rent 30;

player 1 money 1200 position 0 strategy "reporter";
player 2 money 1200 position 0 strategy "logger";

dice 6 sides;

simulate 8 turns {
    // Print statements para output visible
    print "=== Turn Start ===";
    print "Game state updated";
    print "Player moves calculated";
    print "Board state logged";
    
    // Log statements para archivo de log
    log "Simulation event recorded";
    log "Turn progression tracked";
    log "Game statistics updated";
    log "Output data generated";
    
    // Combinación de print y log
    print "Turn complete";
    log "Turn data saved";
    
    int checkpoint = 3;
    string status = "active";
    
    if (checkpoint > 2) then {
        print "Checkpoint reached";
        log "Milestone achieved";
    }
}
