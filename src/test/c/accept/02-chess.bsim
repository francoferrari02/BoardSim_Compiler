// Chess Game Test
// Strategic board game with 8x8 board, no dice, no money

board ChessBoard loop 64;

// Chess pieces positions (simplified 8x8 board)
cell 0 "a1" cost 0 rent 0;
cell 1 "b1" cost 0 rent 0;
cell 2 "c1" cost 0 rent 0;
cell 3 "d1" cost 0 rent 0;
