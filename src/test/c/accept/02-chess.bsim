// Chess players (no money, just position and strategy)
player 1 money 0 position 4 strategy "defensive";  // e1 (posición inicial del rey blanco)
player 2 money 0 position 60 strategy "aggressive"; // e8 (posición inicial del rey negro)

// No dice in chess - strategic movement only

simulate 5 turns {
    print "Chess game begins!";
    log "Strategic simulation running";
}
