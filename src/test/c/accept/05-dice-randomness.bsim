// Test A1.5: Usar dice para aleatoriedad en reglas
// Verifica: declaración de dice que el backend usa para movimiento aleatorio

board DiceBoard loop 30;

cell 0 "Start" cost 0 rent 0;
cell 6 "Lucky Space" cost 0 rent 0;
cell 12 "Dice Bonus" cost 50 rent 10;
cell 18 "Random Event" cost 100 rent 20;
cell 24 "Jackpot" cost 0 rent 0;
cell 29 "Finish" cost 0 rent 0;

player 1 money 1000 position 0 strategy "random";
player 2 money 1000 position 0 strategy "aggressive";

// Dice usado para generar movimiento aleatorio
dice 12 sides;

simulate 15 turns {
    print "Dice-based movement simulation";
    log "Random movement using dice roll";
    
    // El backend usa dice para calcular movimiento
    // Simulación interna: pos = (pos + dice_roll) % board_size
}
