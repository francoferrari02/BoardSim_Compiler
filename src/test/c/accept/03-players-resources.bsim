// Test A1.3: Crear jugadores con recursos (money) diferentes
// Verifica: players con diferentes cantidades de dinero (resources)

board ResourceBoard loop 20;

cell 0 "Start" cost 0 rent 0;
cell 5 "Resource Zone 1" cost 100 rent 20;
cell 10 "Resource Zone 2" cost 200 rent 40;
cell 15 "Resource Zone 3" cost 300 rent 60;
cell 19 "End" cost 0 rent 0;

// Jugadores con diferentes recursos iniciales
player 1 money 500 position 0 strategy "conservative";
player 2 money 1000 position 0 strategy "aggressive";
player 3 money 1500 position 0 strategy "balanced";

dice 8 sides;

simulate 8 turns {
    print "Resource management simulation";
    log "Players with different starting resources";
}
