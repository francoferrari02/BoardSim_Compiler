// Test A1.6: Simular turns con loops y condicionales
// Verifica: estructuras de control (if/else, for, while) y variables

board ControlFlowBoard loop 12;

cell 0 "Start" cost 0 rent 0;
cell 6 "Midpoint" cost 100 rent 20;
cell 11 "End" cost 0 rent 0;

player 1 money 1000 position 0 strategy "strategic";
player 2 money 1000 position 0 strategy "tactical";

dice 6 sides;

simulate 10 turns {
    print "Control flow testing";
    log "Testing if/for/while structures";
    
    // Declaración de variables
    int turn_number = 5;
    string game_phase = "midgame";
    bool is_active = true;
    
    // Condicional if-else
    if (turn_number > 3) then {
        print "Advanced phase activated";
        log "Past early game";
    } else {
        print "Early game phase";
        log "Starting phase";
    }
    
    // Loop for con rango
    for iteration in 1 to 4 {
        print "Processing iteration";
        log "Loop executed";
    }
    
    // Loop while
    while (turn_number > 2) {
        print "While condition active";
        log "Looping based on condition";
    }
}
