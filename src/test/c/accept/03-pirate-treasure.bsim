// Pirate Treasure Game Test
// Adventure game with treasure hunting and exploration

board PirateIsland loop 5;

// Pirate locations
cell 0 "Port" cost 0 rent 0;
cell 1 "Jungle" cost 50 rent 25;
cell 2 "Cave" cost 0 rent 0;
cell 3 "Mountain" cost 100 rent 50;
cell 4 "Treasure" cost 0 rent 200;

// Pirate players
player 1 money 1000 position 0 strategy "explorer";
player 2 money 1000 position 0 strategy "aggressive";

// Pirate dice
dice 8 sides;

simulate 4 turns {
    print "Pirate adventure begins!";
    log "Treasure hunting simulation";
}