// Test A1.10: Flows complejos con múltiples reglas (condicionales anidados)
// Verifica: combinación de múltiples estructuras de control y lógica compleja

board ComplexFlowBoard loop 24;

cell 0 "Start" cost 0 rent 0;
cell 4 "Zone A" cost 50 rent 10;
cell 8 "Zone B" cost 100 rent 20;
cell 12 "Zone C" cost 150 rent 30;
cell 16 "Zone D" cost 200 rent 40;
cell 20 "Zone E" cost 250 rent 50;
cell 23 "Final" cost 0 rent 0;

player 1 money 2500 position 0 strategy "complex";
player 2 money 2500 position 0 strategy "strategic";

dice 8 sides;

simulate 15 turns {
    print "Complex flow execution starting";
    log "Multiple decision paths active";
    
    int rule_level = 8;
    string phase = "advanced";
    bool advanced_rules = true;
    int counter = 12;
    
    // Regla compleja 1: Condicional con múltiples ramas
    if (rule_level > 5) then {
        print "High complexity rules activated";
        log "Advanced rule set enabled";
        
        // Regla anidada
        if (counter > 10) then {
            print "Maximum complexity reached";
            log "Full rule depth active";
        } else {
            print "Medium complexity mode";
            log "Intermediate rules";
        }
        
        // Loop dentro de condicional
        for step in 1 to 3 {
            print "Complex rule iteration";
            log "Processing advanced step";
        }
    } else {
        print "Basic rules active";
        log "Simple rule set";
    }
    
    // Regla compleja 2: Loop con lógica
    for index in 1 to 5 {
        print "Multi-rule processing";
        log "Iterative rule application";
    }
    
    // Regla compleja 3: While con condición
    while (rule_level > 6) {
        print "Sustained rule execution";
        log "Persistent condition active";
    }
    
    // Múltiples outputs finales
    print "All flow rules processed";
    log "Complex execution completed";
    print "System state stable";
    log "Final validation passed";
}
